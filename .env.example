# Copiar este archivo a .env y completar con tus credenciales
# NEVER commit .env to version control!

# API Security
AGENDA_API_KEY=your_secure_api_key_here_change_this
AGENDA_SECRET_KEY=your_secure_secret_key_here_change_this
AGENDA_RESET_TOKEN=your_secure_reset_token_here_change_this

# INPEC Credentials (IMPORTANTE: No compartir)
INPEC_USER=your_inpec_username
INPEC_PASSWORD=your_inpec_password
INPEC_VERIFICATION=Inpec
INPEC_URL=https://sisipec.salud360.app/Inpec360/servlet/ingreso

# Application Settings
FLASK_ENV=production
FLASK_DEBUG=False
LOG_LEVEL=INFO
CHROME_HEADLESS=True

# Database/Storage (Future use)
DATABASE_URL=sqlite:///./bot360.db
